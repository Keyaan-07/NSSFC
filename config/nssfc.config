board_name NSSFC
manufacturer_id NSS

# IMU
resource SPI_SCK 1 A05
resource SPI_MISO 1 A06
resource SPI_MOSI 1 A07
resource GYRO_CS 1 A04
resource GYRO_EXTI 1 A03
set gyro_1_bustype = SPI
set gyro_1_spibus = 1

# Baro
resource SPI_SCK 2 B13
resource SPI_MISO 2 B14
resource SPI_MOSI 2 B15
resource BARO_CS 1 B12
resource BARO_EXTI 1 B11
set baro_bustype = SPI
set baro_spi_device = 2
set baro_hardware = BMP280


# Flash
resource SPI_SCK 3 C10
resource SPI_MISO 3 C11
resource SPI_MOSI 3 C12
resource FLASH_CS 1 A15
set blackbox_device = SPIFLASH
set flash_spi_bus = 3

# Magnetometer
resource I2C_SDA 1 B06
resource I2C_SCL 1 B07
set mag_bustype = I2C
set mag_i2c_device = 1
set mag_hardware = QMC5883

# 2x UART FOR RX AND VTX

resource SERIAL_TX 1 A09
resource SERIAL_RX 1 A10

resource SERIAL_TX 6 C06
resource SERIAL_RX 6 C07

# MOTOR config(four empty pins)
resource MOTOR 1 B00
resource MOTOR 2 B01
resource MOTOR 3 A01
resource MOTOR 4 A00